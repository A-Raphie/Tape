    "lessonT2179": "[...document.querySelectorAll(\"div,tr,li,span,section\")].find(e=>{const r=e.getBoundingClientRect(); return r.width>600&&r.height>40&&r.height<200&&/^T-2179/.test(e.textContent.trim());})",
    "lessonT3113": "[...document.querySelectorAll(\"div,tr,li,span,section\")].find(e=>{const r=e.getBoundingClientRect(); return r.width>600&&r.height>40&&r.height<200&&/^T-3113/.test(e.textContent.trim());})",
