    "gatesExpander": "[...document.querySelectorAll(\"button,[role=button]\")].find(e=>/show all 13 gates/.test(e.textContent))",
    "gateSizeCap": "[...document.querySelectorAll(\"div,tr,li,span\")].find(e=>{const r=e.getBoundingClientRect(); return r.width>500&&r.height>25&&r.height<80&&/^PASSSize cap/.test(e.textContent.trim());})",
    "gateDailyLoss": "[...document.querySelectorAll(\"div,tr,li,span\")].find(e=>{const r=e.getBoundingClientRect(); return r.width>500&&r.height>25&&r.height<80&&/^PASSDaily loss limit/.test(e.textContent.trim());})",
