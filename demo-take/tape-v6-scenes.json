    "receiptHappened": "[...document.querySelectorAll(\"div,span,p,h1,h2,h3,h4,dt\")].filter(e=>{const t=e.textContent; const r=e.getBoundingClientRect(); return /what happened/i.test(t)&&t.length<60&&r.height>0&&r.height<60;}).sort((a,b)=>a.textContent.length-b.textContent.length)[0]",
    "receiptReasoning": "[...document.querySelectorAll(\"div,span,p,h1,h2,h3,h4,dt\")].filter(e=>{const t=e.textContent; const r=e.getBoundingClientRect(); return /analyst.{0,4}s reasoning|analyst/i.test(t)&&t.length<60&&r.height>0&&r.height<60;}).sort((a,b)=>a.textContent.length-b.textContent.length)[0]",
