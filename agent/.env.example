# Copy to .env. Never commit .env.
# Alpaca paper keys (dashboard: Trading -> Paper -> API keys). PAPER ONLY.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# LLM (Groq free tier, OpenAI-compatible)
GROQ_API_KEY=
TAPE_LLM_BASE=https://api.groq.com/openai/v1
TAPE_MODEL=openai/gpt-oss-120b

# Where the journal lives (SQLite + JSONL mirror)
TAPE_DB=./tape.db
